# ─────────────────────────── GX-ID environment ───────────────────────────
# Copy this file to `.env` and fill in your values.

# ── Bot identity ──
BOT_NAME=GX-ID
BOT_DEVELOPER=GX-ID Developer
BOT_NUMBER=
BOT_SUPPORT=

# ── Owner ──
OWNER_NAME=Owner
# Comma-separated, digits only (country code, no + or spaces)
OWNER_NUMBER=6281234567890

# ── Session / authentication ──
# Folder name under ./storage used to store the WhatsApp session
SESSION_FOLDER=session
# true = pairing code, false = QR code
USE_PAIRING_CODE=true
# Phone number used to request the pairing code (digits only, with country code)
# Falls back to BOT_NUMBER when empty
PAIRING_NUMBER=
# Optional 8-char custom pairing code (A-Z, 2-7; no I/L/O/U). Leave empty for random.
PAIRING_CODE=
# Print QR in the terminal when USE_PAIRING_CODE=false
PRINT_QR=true

# ── Bot mode ──
# public | self
BOT_MODE=public

# ── Command ──
PREFIX=.

# ── Message gate ──
# Only react to messages that arrive AFTER the bot is online. Messages queued
# while the bot was off are replayed on reconnect with their original (older)
# timestamps and are ignored. This tolerance (ms) absorbs clock skew and the few
# ms between the socket opening and the bot marking itself online.
MESSAGE_BOOT_GRACE_MS=5000

# ── Channel / newsletter preview ──
# Leave CHANNEL_ID empty to disable the "forwarded from channel" tag
CHANNEL_ID=
CHANNEL_NAME=GX-ID Channel
CHANNEL_LINK=

# ── Assets (local path or remote URL) ──
ASSET_MENU=./media/menu.png
ASSET_THUMB=./media/thumb.png
ASSET_AUDIO=

# ── Sticker metadata ──
STICKER_PACK=GX-ID
STICKER_AUTHOR=GX-ID

# ── Database ──
DATABASE_PATH=./database/main

# ── Self-update (GitHub) ──
# Repository the `.update` / `.checkupdate` commands pull from.
# Accepts `owner/repo`, `owner/repo#branch`, or `https://github.com/owner/repo`.
GITHUB_REPO=
# Optional branch/tag/sha override (default: the repo's default branch).
GITHUB_BRANCH=
# Optional personal access token — needed for private repos and higher rate limits.
GITHUB_TOKEN=
# "true" to automatically restart the bot right after `.update` applies.
UPDATE_AUTO_RESTART=false

# ── Content moderation (optional) ──
# `.antinsfw` picks a backend at runtime:
#
#   1. LOCAL (default, no config needed) — an on-device nsfwjs + TensorFlow.js
#      model. The model ships inside the `nsfwjs` package and loads OFFLINE,
#      so nothing leaves the server. First classification is slow (model load);
#      later ones are faster. Disable with NSFW_LOCAL_MODEL=false.
#
#   2. REMOTE — set NSFW_API_URL and images are POSTed there as JSON
#      `{ image: <base64> }`; the reply is read as `{ nsfw: bool }`
#      (also accepts `{ safe }` / `{ label }`). Takes precedence over local.
#      NSFW_API_KEY, when set, is sent as a bearer token.
#
# Animated media (video/GIF/animated sticker) is always sampled on-device with
# the bundled ffmpeg; the remote backend only classifies single images.
NSFW_LOCAL_MODEL=true
NSFW_API_URL=
NSFW_API_KEY=
# Combined NSFW probability (Porn+Hentai+Sexy) at/above which a frame is flagged.
NSFW_THRESHOLD=0.75
# Frames sampled from a video/GIF (higher = more thorough but slower).
NSFW_VIDEO_FRAME_SAMPLES=4

# ── Runtime ──
# development enables extra debug logging
NODE_ENV=production

# ── Interactive console ──
# Seconds of inactivity in the pre-boot control panel before the bot starts
# automatically. 0 disables the auto-start timeout. Editable from the
# Settings screen without restarting.
MENU_TIMEOUT=30
# The bot hosts a local control socket so `npm run console` (in another
# terminal) can drive it interactively. Set NO_CONSOLE=1 to disable it.
NO_CONSOLE=0
# Override the control socket path (default: a named pipe / tmp socket).
CONSOLE_PIPE=

# ── Hot reload ──
# Watches plugins/** (soft reload, no downtime) and config.js / GX.js / .env
# (full restart) so edits apply automatically. Set HOT_RELOAD=0 to disable.
HOT_RELOAD=1
# Set HOT_RELOAD_RESTART=0 to watch plugins only and ignore config/.env changes.
HOT_RELOAD_RESTART=1
# Quiet period (ms) before a detected change is applied (debounce).
HOT_RELOAD_DEBOUNCE=800

# ── WhatsApp ↔ Minecraft bridge (XMPP) ──
# Two-way TEXT-ONLY chat relay through EssentialsXMPP + Prosody. All XMPP
# settings live in config/xmpp.js and are read from here — never hardcode
# credentials in source files. Bridge groups are managed at runtime with the
# `.xmpp` command (stored in the bot database).
#
# Master switch. Off by default so the bot is unaffected until you enable it.
XMPP_ENABLED=false
XMPP_HOST=xmpp.anargya.my.id
XMPP_PORT=7777
# Domain used for authentication. Falls back to XMPP_HOST when empty.
XMPP_DOMAIN=xmpp.anargya.my.id
XMPP_USERNAME=minecraft
XMPP_PASSWORD=
# Resource / device name for the session.
XMPP_RESOURCE=gx-id
# false = plain TCP + opportunistic STARTTLS (typical Prosody test setup).
# true  = direct TLS (xmpps://).
XMPP_REQUIRE_TLS=false
# Optional MUC room JID. When set, chat is sent/received as groupchat; when
# empty a direct message is sent to XMPP_TO instead.
XMPP_ROOM=
# Nickname used inside the MUC room.
XMPP_NICK=WhatsApp
# Direct recipient JID used when XMPP_ROOM is empty.
XMPP_TO=
# Initial bridge groups (comma-separated group JIDs). Only a SEED — the live
# list is stored in the database and managed via `.xmpp setgroup`.
XMPP_BRIDGE_GROUPS=
# Minecraft chat length limit; longer WhatsApp text is safely truncated.
XMPP_MAX_LENGTH=240
# Comma-separated prefixes never relayed to Minecraft (commands). The bot's own
# command prefix is already excluded automatically.
XMPP_BLOCK_PREFIXES=/
# Rate limit for WhatsApp → Minecraft only (spam protection).
XMPP_RATE_MAX=3
XMPP_RATE_WINDOW_MS=5000
# Reconnect backoff (exponential) bounds, in milliseconds.
XMPP_RECONNECT_MIN_MS=1000
XMPP_RECONNECT_MAX_MS=30000
# Message formatting (optional overrides).
XMPP_IN_HEADER=⛏️ Minecraft
XMPP_OUT_PREFIX=[WA]
